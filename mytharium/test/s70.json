[{"step":1},{"eval":"const m=A.state().crits.find(c=>c.sp==='mermaid');const M=A.get(m.id);const rock=A._eval('baskRock()');const en=A._eval('waterBeside([baskRock().x,0,baskRock().z],baskRock())');M.target=A._eval('baskPoint(baskRock())');M.entry=en;A.setState(m.id,'haul',1);const log=[];for(let i=0;i<40;i++){A.step(.5);log.push(M.state+':'+M.pos.map(v=>+v.toFixed(1)));if(M.state==='bask'&&M.t>1)break;}A.cam({target:[M.pos[0],M.pos[1]+1,M.pos[2]],yaw:.5,pitch:.35,dist:20});return {rock:[rock.kind,rock.x,rock.z],en,log:log.filter((x,i,a)=>i===0||x.split(':')[0]!==a[i-1].split(':')[0]||i===a.length-1)}"},{"shot":"onrock"},
 {"eval":"const m=A.state().crits.find(c=>c.sp==='mermaid');const M=A.get(m.id);M.t=M.dur+1;const log=[];for(let i=0;i<30;i++){A.step(.25);log.push(M.state+':'+M.pos.map(v=>+v.toFixed(1)));if(i===2){A.cam({target:[M.pos[0],M.pos[1]+1,M.pos[2]],yaw:.5,pitch:.35,dist:20});A.frame();}if(M.state==='swim'&&M.t>.6)break;}return log.filter((x,i,a)=>i===0||x.split(':')[0]!==a[i-1].split(':')[0]||i===a.length-1)"},{"shot":"afterslip"},
 {"eval":"const m=A.state().crits.find(c=>c.sp==='mermaid');const M=A.get(m.id);const sp=A._eval('beachSpot()');const en=A._eval('waterBeside('+JSON.stringify(sp)+',null,1.8)');M.target=sp;M.entry=en;A.setState(m.id,'haul',1);const log=[];for(let i=0;i<60;i++){A.step(.5);log.push(M.state+':'+M.pos.map(v=>+v.toFixed(1)));if(M.state==='bask'&&M.t>1.5)break;}A.cam({target:[M.pos[0],M.pos[1]+1,M.pos[2]],yaw:.2,pitch:.3,dist:22});return {sp,en,log:log.filter((x,i,a)=>i===0||x.split(':')[0]!==a[i-1].split(':')[0]||i===a.length-1),errs:A.state().errs}"},{"shot":"beach"}]
