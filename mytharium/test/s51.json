[{"step":1},{"eval":"const f=A.state().crits.find(c=>c.sp==='faerie'),u=A.state().crits.find(c=>c.sp==='unicorn');const F=A.get(f.id),U=A.get(u.id);F.mount=U;A.setState(f.id,'ride',30);A.setState(u.id,'idle',30);A.step(2);A.cam({target:[U.pos[0],U.pos[1]+6,U.pos[2]],yaw:.5,pitch:.12,dist:24});return [F.state,F.pos.map(v=>+v.toFixed(1)),U.pos.map(v=>+v.toFixed(1))]"},{"shot":"ride"},
 {"eval":"A.time('night');for(const c of A.state().crits){if(c.sp==='unicorn'||c.sp==='foal'){const C=A.get(c.id);C.pos[0]=-2+Math.random()*2;C.pos[2]=8+Math.random()*2;A.setState(c.id,'sleep',200);}}A.step(8);const u=A.get(A.state().crits.find(c=>c.sp==='unicorn').id);A.cam({target:[u.pos[0],u.pos[1]+3,u.pos[2]],yaw:.4,pitch:.5,dist:40});return A.state().crits.filter(c=>c.sp!='faerie').map(c=>c.sp+':'+c.state+':'+c.pos.map(v=>Math.round(v)))"},{"shot":"sleepers"}]
