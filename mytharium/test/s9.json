 {"eval":"A.feed('clover',0,10);A.feed('nectar',-10,8);A.feed('cricket',-36,0);A.feed('seagrape',30,-5);A.step(25);return A.state().crits.map(c=>c.sp+':'+c.state+':'+c.hunger)"},
