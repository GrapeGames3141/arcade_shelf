// Cartastrophe Online prototype. Uses only Workers Free features: a Worker, static assets, and a SQLite-backed
// Durable Object class (SQLite storage is the only Durable Object backend available on Workers Free).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cartastrophe-online",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": { "enabled": false },
  "routes": [{ "pattern": "multiplayer.thearcadeshelf.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
